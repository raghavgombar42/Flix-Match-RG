# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Supabase (frontend-safe: URL + publishable/anon key, protected by RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-side / CLI only — DO NOT expose to the browser) ---
SUPABASE_PROJECT_REF=
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=

# --- AI (server-side only) ---
GEMINI_API_KEY=

# --- TMDB (server-side only) ---
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# --- RapidAPI / OTT Details (server-side only) ---
RAPID_API_KEY=
RAPID_API_HOST=ott-details.p.rapidapi.com
